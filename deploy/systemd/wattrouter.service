# wattrouter.service — the router, as a system service.
#
# History
#   2026-08-05  A. Sigdel  Created.
#
# Install:
#   sudo cp deploy/systemd/wattrouter.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now wattrouter

[Unit]
Description=wattrouter — routes model requests to the cheapest tier that can serve them
Documentation=https://github.com/asigdel29/anu-agentic-stack
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=hermes
Group=hermes

# The credential lives here and nowhere else on the board. 0600, owned by root:
# the service reads it before dropping to its own user.
EnvironmentFile=/etc/wattrouter.env
ExecStart=/usr/local/bin/wattrouter

# Always restart. A router that has stopped takes the whole stack with it, and
# every failure mode it has — an unreachable upstream, a closed socket — is one a
# restart can plausibly clear.
Restart=always
RestartSec=2

# The router serves loopback only and reads one file. Nothing here is a guess:
# each is a capability it demonstrably does not use.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6
# The embedding model cache, shared with zeromem, is the only path it writes.
ReadWritePaths=/var/lib/wattrouter

# Journal only. Routing lines name models and token counts, never prompt text or
# the credential, so this is safe to leave at info.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
