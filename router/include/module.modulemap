// module.modulemap — makes wattrouter.h importable as a Swift module.
//
// History
//   2026-08-06  A. Sigdel  Created.
//
// Without this the header is a file clang can include and nothing Swift can
// import. The name is the one Swift writes, and it matches the binary target in
// ios/Package.swift; changing one without the other breaks the import with a
// message that names neither.

module WattRouterFFI {
    header "wattrouter.h"
    export *
}
