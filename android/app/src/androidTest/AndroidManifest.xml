<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml — components that exist only for the suite.

  History
    2026-08-09  A. Sigdel  Created to hold a FLAG_SECURE activity.

  Merged into the test APK alone, so nothing here ships. An activity is the
  only way to ask what an accessibility service sees of a window somebody else
  marked secure, and no app on the emulator is guaranteed to have one.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="com.getlora.wattrouter.app.SecureActivity"
            android:exported="true" />
    </application>
</manifest>
