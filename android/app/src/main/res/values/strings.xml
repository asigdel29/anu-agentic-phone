<?xml version="1.0" encoding="utf-8"?>
<!--
  strings.xml — text the system shows, as opposed to text the app draws.

  History
    2026-08-08  A. Sigdel  Created.

  Only what appears outside a Compose tree belongs here. What the app draws is a
  Kotlin string beside the code that draws it.
-->
<resources>
    <string name="app_name">WattRouter</string>

    <!--
      Shown on the Settings screen where somebody turns the service on, which
      is the one moment they decide whether to. So it says what is read and
      what is not, rather than what the feature is called.
    -->
    <string name="driving_description">Lets the assistant read what is on
        screen and act on it, when you ask it to do something on your phone.
        What it reads goes to the model answering you and is not stored or
        logged. Apps that hide their contents from accessibility, such as
        banking apps, stay hidden.</string>

    <!-- On the overlay, over whatever is being driven. One word, because it
         sits beside a sentence and the sentence is the part to read. -->
    <string name="banner_stop">Stop</string>

    <!--
      On the bubble. One character, because the bubble is a thumb wide and sits
      over somebody else's design; a word would either not fit or would have to
      shrink until it could not be read.
    -->
    <string name="chat_head_label">W</string>

    <!--
      What a screen reader says instead. The bubble decides a tap from a drag
      itself and so has no click listener to describe, which is exactly when a
      content description stops being a courtesy.
    -->
    <string name="chat_head_description">Open WattRouter</string>
</resources>
