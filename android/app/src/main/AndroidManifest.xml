<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml — what the app is allowed to do, and where it starts.

  History
    2026-08-08  A. Sigdel  Created with one permission and one activity.
    2026-08-09  A. Sigdel  The three AndroidAsking asks for.

  INTERNET is the only permission the app can grant itself. Everything else
  arrives with the code that explains it, because a permission declared ahead of
  its reason is one nobody can weigh — and, less obviously, one declared behind
  its reason cannot be asked for at all: checkSelfPermission refuses it, the
  dialog does not appear, and the app reports a permanent denial naming a
  Settings row that is not there.

  allowBackup is false rather than unset: the store this app is about to hold is
  somebody's conversations, and cloud backup would copy it somewhere none of the
  decisions about it apply.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Without this the package manager admits almost nothing exists, and
      open_app answers "there is no app called that" for every app on the
      phone — a total failure whose message reads like a spelling mistake.

      Scoped to apps with a launcher icon, which is exactly the set open_app
      offers. QUERY_ALL_PACKAGES would also work, is a restricted permission,
      and asks for far more than is needed.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      A turn that outlives the screen. specialUse rather than dataSync: Android
      15 caps dataSync at six hours in twenty-four and then calls onTimeout().
      POST_NOTIFICATIONS because the service's whole value is being visible, and
      a foreground service whose notification is suppressed is a turn running
      where nobody can stop it.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      What AndroidAsking spells the three capabilities as. Read-only: nothing
      here writes to a calendar or a contact yet, and a permission asked for
      ahead of the tool that needs it is a dialog somebody answers no to.

      Coarse location rather than fine, and AndroidAsking says why: asking for
      fine from API 31 obliges an app to ask for coarse beside it and adds a
      precise/approximate choice to the dialog, for an accuracy nothing here
      wants.
    -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WattRouter">

        <!--
          singleTop, and it is load-bearing rather than tidy. Under the default
          launch mode a share starts a second MainActivity, and this app holds a
          Core and a Memory per instance: a second core is a second decision
          cache, and a second store is a second mutex over one file, which
          Memory.kt argues against directly. singleTop reuses the instance that
          exists and delivers through onNewIntent.

          Not singleTask, which would also finish anything above it. There is
          nothing above it — one activity — so that is a behaviour to adopt when
          there is something for it to do, which is the overlay work in #233.
        -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              text/* rather than */*. A stream is a file, and there is no file
              tool here to hand one to; offering the app in every share sheet
              and then refusing is worse than not appearing in it.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>

            <!--
              The assist gesture: long-press home, or whatever the device maps
              it to. #527 overturns the design review's refusal of this, and the
              argument is worth having here because the refusal was right at the
              time — the role was wanted then as a way to read the screen, and
              AssistStructure is a read-only snapshot where the accessibility
              service has the live tree. As an invocation that objection does
              not apply.

              What is still true is that Android has one assistant slot, so
              being chosen for it means the gesture stops reaching whatever held
              it. That is a real loss, and it is why this only puts the app in
              the picker: nothing is taken, somebody chooses it in Settings >
              Default apps > Digital assistant app. An app that never appears
              there has made that choice on their behalf.

              No wake word follows from this, and nothing should claim one.
              AlwaysOnHotwordDetector needs a VoiceInteractionService that
              currently holds the role, DSP support, and a vendor enrollment
              application to have enrolled the phrase, and an app cannot supply
              the last of those.
            -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          BIND_ACCESSIBILITY_SERVICE is the system's guarantee that only it can
          bind this, and its absence is silent: the service is simply never
          bound. exported must be true — the binder is the system, which is
          another process.
        -->
        <service
            android:name=".DrivingService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/driving" />
        </service>

        <service
            android:name=".TurnService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Running a language-model turn the person started" />
        </service>
    </application>
</manifest>
